import personas.*
import construcciones.*
import planetas.*

describe "Tests de primera parte" {
  const lovely = new Planeta()
  const pebbles = new Planeta()

  const tim = new Persona(edad = 26)
  const jason = new Persona(edad = 15, recursos = 50)
  const richard = new Persona(edad = 40)
  const damian = new Persona(edad = 80, recursos = 15)
  const bruce = new Persona (edad = 76, recursos = 5)
  const john = new Persona(edad = 12)

  const m1 = new Muralla(longitud = 30)
  const m2 = new Muralla(longitud = 40)
  const m3 = new Museo(superficie = 20, nivelImportancia = 4)
  const m4 = new Muralla(longitud = 5)
  const m5 = new Museo(superficie = 7, nivelImportancia = 2)

  method initialize() {
    lovely.agregarHabitantes([tim, jason, richard, damian])
    lovely.agregarConstrucciones([m1, m2, m3])

    pebbles.agregarHabitantes([bruce, john])
    pebbles.agregarConstrucciones([m4, m5])
  }

  test "La delegacion diplomatica de lovely es conformada por tim, jason y richard" {
    assert.equals(#{tim, jason, richard}, lovely.delegacionDiplomatica())
  }

  test "Lovely es un planeta valioso" {
    assert.that(lovely.esValioso())
  }

  test "Pebbles no es valioso" {
    assert.notThat(pebbles.esValioso())
  }

  test "Si bruce gana 50 monedas, pasa a ser parte de la delegacion diplomatica" {
    bruce.ganarRecursos(50)

    assert.equals(#{bruce}, pebbles.delegacionDiplomatica())
  }
}